# Compilado
target/
!.mvn/wrapper/maven-wrapper.jar

# Secretos: nada de esto va al repositorio.
# La clave de Gemini y la contrasena de la base viajan como variables de
# entorno en la plataforma de despliegue, nunca en un archivo versionado.
.env
.env.*
*.key

# application-local.yml SI va al repositorio, aunque el nombre suene a archivo
# personal. Es la configuracion del perfil local y no tiene ningun secreto: la
# base corre en Docker con credenciales de juguete y la clave de firma no
# protege nada real. Sin ese archivo, quien clone el proyecto no puede
# levantarlo sin antes adivinar como configurarlo.
#
# Lo que si queda afuera es cualquier variante personal:
application-local-*.yml
application-personal.yml

# Entornos de desarrollo
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Sistema
.DS_Store
Thumbs.db
